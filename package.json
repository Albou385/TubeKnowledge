{
  "name": "tubeknowledge",
  "version": "1.0.1",
  "private": true,
  "description": "Bibliothèque Markdown locale avec acquisition et transcription hors vault.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build",
    "agent:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent/preflight.ps1",
    "agent:quality": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent/quality-gate.ps1",
    "agent:user-journey": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent/user-journey-smoke.ps1",
    "phase3:demo-package": "tsx scripts/generate-phase3-demo-package.ts",
    "phase3:obsidian-copy-check": "tsx scripts/phase10-4-obsidian-copy-check.ts",
    "phase3:smoke": "vitest run src/lib/imports/phase3-smoke.test.ts",
    "phase4:check": "powershell -ExecutionPolicy Bypass -File scripts/check-transcription-tools.ps1",
    "phase4:smoke": "powershell -ExecutionPolicy Bypass -File scripts/phase4-smoke-fake.ps1",
    "phase5:smoke": "powershell -ExecutionPolicy Bypass -File scripts/phase5-smoke-fake.ps1",
    "phase5:manual-check": "powershell -ExecutionPolicy Bypass -File scripts/phase5-manual-check.ps1",
    "phase6:check": "powershell -ExecutionPolicy Bypass -File scripts/check-portability.ps1",
    "phase6:diagnose": "powershell -ExecutionPolicy Bypass -File scripts/diagnose-portability-state.ps1",
    "phase6:recovery-plan": "powershell -ExecutionPolicy Bypass -File scripts/plan-portability-recovery.ps1",
    "phase6:maintenance": "powershell -ExecutionPolicy Bypass -File scripts/maintain-portability-local-state.ps1",
    "phase6:smoke": "powershell -ExecutionPolicy Bypass -File scripts/phase6-smoke-fake.ps1",
    "phase6:manual-check": "powershell -ExecutionPolicy Bypass -File scripts/phase6-manual-check.ps1",
    "phase7:smoke": "powershell -ExecutionPolicy Bypass -File scripts/phase7-smoke-fake.ps1",
    "phase11a:smoke": "node --import ./scripts/node-tsx-windows-bootstrap.mjs --import tsx scripts/phase11a-smoke-fake.ts",
    "phase11b:smoke": "node --import ./scripts/node-tsx-windows-bootstrap.mjs --import tsx scripts/phase11b-smoke-fake.ts",
    "travel:smoke": "node --import ./scripts/node-tsx-windows-bootstrap.mjs --import tsx scripts/travel-portability-smoke-fake.ts",
    "e2e": "playwright test tests/e2e/phase10-2.spec.ts",
    "e2e:phase10-1": "playwright test tests/e2e/overnight-qa.spec.ts",
    "e2e:phase10-3": "playwright test --config=playwright.phase10-3.config.ts",
    "e2e:phase10-4": "playwright test --config=playwright.phase10-4.config.ts",
    "e2e:phase11b": "powershell -ExecutionPolicy Bypass -File scripts/phase11b-e2e-fake.ps1",
    "test:worker": "python -m pytest transcription-worker/tests",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "next": "16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    },
    "nanoid": "3.3.18",
    "sharp": "0.35.3"
  }
}
