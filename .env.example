# Copiez ce fichier vers .env.local et adaptez le chemin à votre poste Windows.
YOUTUBE_LIBRARY_PATH=C:\chemin\vers\votre-vault

# Facultatif : active le lien « Ouvrir dans Obsidian » sans exposer le chemin Windows.
OBSIDIAN_VAULT_NAME=projet_youtube

# Phase 4 - laissez le runtime hors du dépôt, du vault et de OneDrive.
TUBEKNOWLEDGE_RUNTIME_PATH=
# Recommandé pour une reprise Portable : sessions Apply persistantes, hors OneDrive.
TUBEKNOWLEDGE_IMPORT_SESSION_PATH=
TUBEKNOWLEDGE_PYTHON_PATH=
TUBEKNOWLEDGE_FFMPEG_PATH=
TUBEKNOWLEDGE_FFPROBE_PATH=
TUBEKNOWLEDGE_TRANSCRIPTION_CONCURRENCY=1
TUBEKNOWLEDGE_DEFAULT_WHISPER_MODEL=small
TUBEKNOWLEDGE_DEFAULT_WHISPER_DEVICE=cpu
TUBEKNOWLEDGE_DEFAULT_COMPUTE_TYPE=int8
TUBEKNOWLEDGE_MAX_VIDEO_MINUTES=360

# Phase 5 - facultatif, utilisé uniquement comme lien externe HTTPS côté interface.
TUBEKNOWLEDGE_CHATGPT_PROJECT_URL=

# Phase 6 - identite et donnees techniques locales, toujours hors OneDrive.
TUBEKNOWLEDGE_MACHINE_NAME=
TUBEKNOWLEDGE_MACHINE_ROLE=reader
TUBEKNOWLEDGE_PORTABILITY_STATE_PATH=
TUBEKNOWLEDGE_BACKUP_PATH=
TUBEKNOWLEDGE_ONEDRIVE_ROOT=
TUBEKNOWLEDGE_STABILITY_WINDOW_SECONDS=3
TUBEKNOWLEDGE_WRITER_LEASE_MINUTES=30
TUBEKNOWLEDGE_BACKUP_RETENTION_COUNT=10

# Phase 8/12 - manuel par défaut; mock local déterministe pour la QA.
TUBEKNOWLEDGE_ANALYSIS_PROVIDER=manual
# Le provider OpenAI est facultatif, server-side et désactivé par défaut.
TUBEKNOWLEDGE_ENABLE_PAID_AI=false
TUBEKNOWLEDGE_OPENAI_MODEL=
# Ne jamais inscrire une clé réelle dans Git; garder OPENAI_API_KEY uniquement dans .env.local.
OPENAI_API_KEY=
